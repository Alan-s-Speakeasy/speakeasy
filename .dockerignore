# Without this file the build context is ~1 GB (frontend/node_modules alone is
# 550 MB) and every docker build spends minutes just uploading it.

.git
.gitignore
.idea
.kotlin
.DS_Store

# Build output and tool caches — everything is rebuilt inside the image.
**/build
**/.gradle
.gradle
frontend/dist
frontend/node_modules
frontend/.angular
frontend/.bash_profile

# Generated by `gradlew openApiGenerate` during stage 1. Excluded so the build
# never silently reuses a stale client from the host.
frontend/openapi

# Runtime state. These are bind-mounted at run time, never baked into the image:
# an image containing a copy of database.db would quietly diverge from the live
# one on the server.
data
logs
session-store
backend/session-store
backend/data
assignment.json

# Not needed to build or run.
Dockerfile
compose.yaml
docker-compose.yml
readme.md
LICENSE
scripts
