# Per-server settings for docker compose. Copy to .env and edit:
#
#     cp .env.example .env
#
# docker compose reads .env from this directory automatically. It is gitignored,
# so each server keeps its own values and nothing server-specific is committed.

# --- File ownership --------------------------------------------------------
# MUST match the owner of ./data and ./logs, or the app cannot create
# database.db and dies on startup. Find yours with: id -u  /  id -g
APP_UID=1000
APP_GID=1000

# --- Network ---------------------------------------------------------------
# 127.0.0.1 = reachable only through a reverse proxy on this host (production).
# 0.0.0.0   = published on the network, plain HTTP, no TLS. This is what the old
#             tmux deployment effectively did, so it is the setting that makes a
#             dev server reachable at http://devserver:8080.
#
# Reminder: published ports bypass ufw/firewalld.
SPEAKEASY_BIND_ADDR=127.0.0.1
SPEAKEASY_PORT=8080

# --- Runtime ---------------------------------------------------------------
TZ=Europe/Zurich

# Overrides the -Xms4G -Xmx16G hardcoded in backend/build.gradle. The generated
# start script applies JAVA_OPTS after those defaults, so the last -Xmx wins.
JAVA_OPTS=-Xms512m -Xmx2g

# Keep comfortably above the -Xmx above: the JVM needs headroom beyond the heap
# for metaspace, thread stacks and native buffers.
SPEAKEASY_MEMORY_LIMIT=3g

# --- Extra CLI arguments ---------------------------------------------------
# Forwarded verbatim to the backend binary — the equivalent of the `-- <args>`
# passthrough in scripts/deploy.sh.
SPEAKEASY_EXTRA_ARGS=
